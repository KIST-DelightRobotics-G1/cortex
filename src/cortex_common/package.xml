<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cortex_common</name>
  <version>0.0.1</version>
  <description>
    Small helpers shared by every cortex node. Today: EventLog, the opt-in console
    and recorded events chosen per node in cortex_bringup/config/logging.yaml.
  </description>
  <maintainer email="park50260@gmail.com">박성용</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>std_msgs</exec_depend>  <!-- String on /cortex/events -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
