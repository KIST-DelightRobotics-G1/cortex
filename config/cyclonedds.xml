<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">

  <!--
    Domain 0: the robot's domain, shared with ext-sensor-io, gearsonic,
    navigation-planner and vla-inference. (Domain 1 was the bridge to the
    onboard stack, which is no longer used.)

    Unicast-only peer discovery: multicast is off, the NX is listed as an
    explicit peer. DDS_PEER_IP must resolve to the NX before launch (see env.sh).

    TODO(REQ-XX): confirm the PC NIC name below on the demo machine
    (`ip -br link`). It is host-specific and NOT portable.
  -->
  <Domain Id="0">
    <General>
      <Interfaces>
        <!-- PC NIC facing the robot LAN. Change to match the demo machine. -->
        <NetworkInterface name="eno2" priority="default" multicast="false"/>
        <!-- No "lo" here: with a second interface Cyclone also sends discovery to
             DDS_PEER_IP from a 127.0.0.1-bound socket, which the kernel refuses
             (ddsi_udp_conn_write ... retcode -3, ~20 lines per node per cycle).
             Nodes on this host still find each other through the localhost peer. -->
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <Discovery>
      <Peers>
        <Peer address="localhost"/>
        <Peer address="${DDS_PEER_IP}"/>
        <!-- G1 internal PC: runs the audio service ("voice") speaker_node calls. With
             multicast off it is only found if listed. Verify the address on the robot. -->
        <Peer address="${DDS_ROBOT_IP}"/>
      </Peers>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>20</MaxAutoParticipantIndex>
      <EnableTopicDiscoveryEndpoints>true</EnableTopicDiscoveryEndpoints>
    </Discovery>
    <Internal>
      <Watermarks>
        <WhcHigh>2MB</WhcHigh>
      </Watermarks>
    </Internal>
    <Tracing>
      <Verbosity>warning</Verbosity>
      <OutputFile>stderr</OutputFile>
    </Tracing>
  </Domain>

</CycloneDDS>
